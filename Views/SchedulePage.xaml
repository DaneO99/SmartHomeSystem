<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:vm="clr-namespace:SmartHomeApp.ViewModels"
  xmlns:models="clr-namespace:SmartHomeApp.Models"
  xmlns:converters="clr-namespace:SmartHomeApp.Converters"
  x:Class="SmartHomeApp.Views.SchedulePage"
  Title="Schedules"
  BackgroundColor="White"
  x:DataType="vm:MainViewModel">

  <ContentPage.Resources>
    <!-- All Buttons Blue/White -->
    <Style TargetType="Button">
      <Setter Property="BackgroundColor" Value="Blue" />
      <Setter Property="TextColor" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <converters:DeviceIdsToNamesConverter x:Key="IdsToNames" />
  </ContentPage.Resources>

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="20">

      <!-- Logo -->
      <Image Source="schedulelogo.png"
             HeightRequest="60"
             WidthRequest="60"
             HorizontalOptions="Center" />

      <!-- Form Title -->
      <Label x:Name="FormTitle"
             Text="Create On/Off Schedule"
             FontSize="24"
             TextColor="Black" />

      <!-- Schedule Name -->
      <Entry x:Name="ScheduleNameEntry"
             Placeholder="Schedule Name"
             HorizontalOptions="FillAndExpand" />

      <!-- Device Selection -->
      <Label Text="Select Devices" TextColor="Black"/>
      <ScrollView HeightRequest="120">
        <VerticalStackLayout
          x:Name="DeviceSelectionLayout"
          Spacing="5"
          BindableLayout.ItemsSource="{Binding Devices}">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:Device">
              <HorizontalStackLayout Spacing="10">
                <CheckBox CheckedChanged="OnDeviceCheckChanged"
                          Color="Blue"
                          VerticalOptions="Center"/>
                <Label Text="{Binding Name}"
                       VerticalOptions="Center"/>
              </HorizontalStackLayout>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </ScrollView>

      <!-- Time Pickers -->
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
        <Label Text="Start:" TextColor="Black" VerticalOptions="Center"/>
        <TimePicker x:Name="OnTimePicker" Time="08:00:00" />
        <Label Text="End:"   TextColor="Black" VerticalOptions="Center"/>
        <TimePicker x:Name="OffTimePicker" Time="20:00:00" />
      </HorizontalStackLayout>

      <!-- Desired Temp -->
      <Entry x:Name="DesiredTempEntry"
             Placeholder="Desired Temp (60–90°F)"
             Keyboard="Numeric"
             HorizontalOptions="FillAndExpand" />

      <!-- Repeat Days -->
      <Label Text="Repeat On:" TextColor="Black"/>
      <FlexLayout Wrap="Wrap"
                  Direction="Row"
                  JustifyContent="Start"
                  AlignItems="Center">
        <StackLayout Padding="5">
          <Label Text="Sun" HorizontalOptions="Center"/>
          <CheckBox x:Name="SundayCheck"    Color="Blue" HorizontalOptions="Center"/>
        </StackLayout>
        <StackLayout Padding="5">
          <Label Text="Mon" HorizontalOptions="Center"/>
          <CheckBox x:Name="MondayCheck"    Color="Blue" HorizontalOptions="Center"/>
        </StackLayout>
        <StackLayout Padding="5">
          <Label Text="Tue" HorizontalOptions="Center"/>
          <CheckBox x:Name="TuesdayCheck"   Color="Blue" HorizontalOptions="Center"/>
        </StackLayout>
        <StackLayout Padding="5">
          <Label Text="Wed" HorizontalOptions="Center"/>
          <CheckBox x:Name="WednesdayCheck" Color="Blue" HorizontalOptions="Center"/>
        </StackLayout>
        <StackLayout Padding="5">
          <Label Text="Thu" HorizontalOptions="Center"/>
          <CheckBox x:Name="ThursdayCheck"  Color="Blue" HorizontalOptions="Center"/>
        </StackLayout>
        <StackLayout Padding="5">
          <Label Text="Fri" HorizontalOptions="Center"/>
          <CheckBox x:Name="FridayCheck"    Color="Blue" HorizontalOptions="Center"/>
        </StackLayout>
        <StackLayout Padding="5">
          <Label Text="Sat" HorizontalOptions="Center"/>
          <CheckBox x:Name="SaturdayCheck"  Color="Blue" HorizontalOptions="Center"/>
        </StackLayout>
      </FlexLayout>

      <!-- Save / Update / Cancel -->
      <HorizontalStackLayout Spacing="10">
        <Button x:Name="SaveScheduleButton"
                Text="Save"
                Clicked="OnSaveScheduleClicked"
                HorizontalOptions="StartAndExpand"/>
        <Button x:Name="UpdateScheduleButton"
                Text="Update"
                Clicked="OnUpdateScheduleClicked"
                IsVisible="False"
                HorizontalOptions="StartAndExpand"/>
        <Button x:Name="CancelEditButton"
                Text="Cancel"
                Clicked="OnCancelEditClicked"
                IsVisible="False"
                HorizontalOptions="StartAndExpand"/>
      </HorizontalStackLayout>

      <!-- Existing Schedules -->
      <Label Text="Existing Schedules"
             FontSize="20"
             TextColor="Black"/>
      <CollectionView x:Name="SchedulesCollectionView"
                      ItemsSource="{Binding Schedules}"
                      CanReorderItems="True"
                      RemainingItemsThreshold="1"
                      RemainingItemsThresholdReached="OnReorderCompleted">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="models:DeviceSchedule">
            <Frame Padding="10"
                   Margin="0,5"
                   BorderColor="LightGray"
                   CornerRadius="8">
              <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Name}"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="Black"/>

                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                  <Label Text="Enabled:" VerticalOptions="Center"/>
                  <Switch x:Name="ScheduleEnabledSwitch"
                          IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                          OnColor="Blue"
                          ThumbColor="White"
                          VerticalOptions="Center"
                          Toggled="OnScheduleEnabledToggled"/>
                </HorizontalStackLayout>

                <Label Text="{Binding DeviceIdsJson, Converter={StaticResource IdsToNames}}"
                       FontAttributes="Italic" />

                <HorizontalStackLayout Spacing="10">
                  <Label Text="Start:" VerticalOptions="Center"/>
                  <Label Text="{Binding OnTime, StringFormat='{0:hh\\:mm}'}" VerticalOptions="Center"/>
                  <Label Text="End:"   VerticalOptions="Center"/>
                  <Label Text="{Binding OffTime, StringFormat='{0:hh\\:mm}'}" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                  <Button Text="Edit"
                          Clicked="OnEditScheduleClicked"
                          CommandParameter="{Binding Id}"
                          HorizontalOptions="StartAndExpand"/>
                  <Button Text="Remove"
                          BackgroundColor="Red"
                          TextColor="White"
                          Clicked="OnRemoveScheduleClicked"
                          CommandParameter="{Binding Id}"
                          HorizontalOptions="End"/>
                </HorizontalStackLayout>
              </VerticalStackLayout>
            </Frame>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
