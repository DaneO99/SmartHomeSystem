<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SmartHomeApp.ViewModels"
    x:Class="SmartHomeApp.Views.MainPage"
    Title="Smart Home Dashboard"
    BackgroundColor="White"
    x:DataType="vm:MainViewModel">

  <Grid Padding="20"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
        ColumnDefinitions="*"
        RowSpacing="20">

    <!-- Logo -->
    <Image Grid.Row="0"
           Source="logo.png"
           HeightRequest="60"
           WidthRequest="60"
           HorizontalOptions="Center" />

    <!-- Devices & Rooms -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="20">
      <Button Text="{Binding Devices.Count, StringFormat='Devices ({0})'}"
              Clicked="GoToDevices"
              BackgroundColor="Blue"
              TextColor="White"
              FontSize="18"
              CornerRadius="8"
              HeightRequest="80"/>
      <Button Grid.Column="1"
              Text="{Binding Groups.Count, StringFormat='Rooms ({0})'}"
              Clicked="GoToRooms"
              BackgroundColor="Blue"
              TextColor="White"
              FontSize="18"
              CornerRadius="8"
              HeightRequest="80"/>
    </Grid>

    <!-- Alarm -->
    <Button Grid.Row="2"
            x:Name="AlarmButton"
            Text="Disarmed"
            Clicked="OnAlarmButtonClicked"
            BackgroundColor="Blue"
            TextColor="White"
            FontSize="18"
            CornerRadius="8"
            HeightRequest="60"/>

    <!-- Lights & Locks -->
    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="20">
      <Button x:Name="LightsToggleButton"
              Text="All Lights"
              Clicked="OnLightsToggledButton"
              BackgroundColor="LightGray"
              TextColor="Black"
              FontSize="18"
              CornerRadius="8"
              HeightRequest="80"/>
      <Button Grid.Column="1"
              x:Name="LocksToggleButton"
              Text="All Locks"
              Clicked="OnLocksToggledButton"
              BackgroundColor="LightGray"
              TextColor="Black"
              FontSize="18"
              CornerRadius="8"
              HeightRequest="80"/>
    </Grid>

    <!-- Current Temp -->
    <Button Grid.Row="4"
            x:Name="CurrentTempButton"
            Text="Temp: --°F"
            IsEnabled="False"
            BackgroundColor="LightGray"
            TextColor="Black"
            FontSize="18"
            CornerRadius="8"
            HeightRequest="60"/>

    <!-- Navigate to SchedulePage -->
    <Button Grid.Row="5"
            Text="Schedules"
            Clicked="GoToSchedules"
            BackgroundColor="Blue"
            TextColor="White"
            FontSize="18"
            CornerRadius="8"
            HeightRequest="60"
            HorizontalOptions="FillAndExpand"/>
  </Grid>
</ContentPage>
