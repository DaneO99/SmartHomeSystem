<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SmartHomeApp.ViewModels"
    xmlns:models="clr-namespace:SmartHomeApp.Models"
    xmlns:converters="clr-namespace:SmartHomeApp.Converters;assembly=SmartHomeApp"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="SmartHomeApp.Views.DevicePage"
    Title="Devices"
    BackgroundColor="White"
    x:DataType="vm:MainViewModel">

  <ContentPage.Resources>
    <!-- Hide thermostat switches -->
    <converters:ThermostatVisibilityConverter x:Key="ThermostatVisibilityConverter" />

    <!-- Template for each device row -->
    <DataTemplate x:Key="DeviceItemTemplate" x:DataType="models:Device">
      <VerticalStackLayout Spacing="10" Padding="0,5">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <Label
            Grid.Column="0"
            Text="{Binding Name}"
            VerticalOptions="Center"
            TextColor="Black" />

          <Switch
            Grid.Column="1"
            IsToggled="{Binding IsOn}"
            OnColor="Blue"
            ThumbColor="White"
            VerticalOptions="Center">
            <Switch.Triggers>
              <DataTrigger
                TargetType="Switch"
                Binding="{Binding Type}"
                Value="Thermostat">
                <Setter Property="IsVisible" Value="False" />
              </DataTrigger>
            </Switch.Triggers>
          </Switch>

          <Button
            Grid.Column="2"
            Text="✕"
            BackgroundColor="Red"
            TextColor="Black"
            CornerRadius="8"
            WidthRequest="36"
            HeightRequest="36"
            Clicked="OnRemoveDeviceClicked"
            CommandParameter="{Binding Id}"
            HorizontalOptions="End" />
        </Grid>

        <!-- Thermostat-only -->
        <VerticalStackLayout
          IsVisible="{Binding Type, Converter={StaticResource ThermostatVisibilityConverter}}"
          Spacing="5">
          <Label
            Text="{Binding Temperature, StringFormat='Temp: {0}°F'}"
            TextColor="Black" />

          <HorizontalStackLayout Spacing="10">
            <Entry
              WidthRequest="60"
              Keyboard="Numeric"
              Placeholder="50–90" />
            <Button
              Text="Set"
              Clicked="OnSetTempClicked" />
          </HorizontalStackLayout>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </DataTemplate>

    <!-- Button style -->
    <Style TargetType="Button">
      <Setter Property="BackgroundColor" Value="Blue" />
      <Setter Property="TextColor" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </ContentPage.Resources>

  <ContentPage.BindingContext>
    <vm:MainViewModel />
  </ContentPage.BindingContext>

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="20">

      <!-- Logo -->
      <Image
        Source="devicelogo.png"
        HeightRequest="60"
        WidthRequest="60"
        HorizontalOptions="Center" />

      <!-- Add New Device -->
      <Label Text="Add New Device"
             FontSize="20"
             TextColor="Black" />

      <Entry x:Name="DeviceNameEntry"
             Placeholder="Enter device name"
             TextColor="Black"
             HorizontalOptions="FillAndExpand" />

      <Picker x:Name="DeviceTypePicker"
              Title="Select device type"
              HorizontalOptions="FillAndExpand">
        <Picker.ItemsSource>
          <x:Array Type="{x:Type x:String}">
            <x:String>Light</x:String>
            <x:String>Thermostat</x:String>
            <x:String>Door Lock</x:String>
          </x:Array>
        </Picker.ItemsSource>
      </Picker>

      <Button Text="Add Device"
              Clicked="OnAddDeviceClicked"
              HorizontalOptions="Start" />

      <!-- Lights Dropdown -->
      <toolkit:Expander>
        <toolkit:Expander.Header>
          <Label Text="Lights"
                 FontSize="18"
                 TextColor="Black"
                 HorizontalOptions="FillAndExpand" />
        </toolkit:Expander.Header>
        <CollectionView
          x:Name="LightsList"
          ItemsLayout="VerticalList"
          ItemTemplate="{StaticResource DeviceItemTemplate}" />
      </toolkit:Expander>

      <!-- Door Locks Dropdown -->
      <toolkit:Expander>
        <toolkit:Expander.Header>
          <Label Text="Door Locks"
                 FontSize="18"
                 TextColor="Black"
                 HorizontalOptions="FillAndExpand" />
        </toolkit:Expander.Header>
        <CollectionView
          x:Name="LocksList"
          ItemsLayout="VerticalList"
          ItemTemplate="{StaticResource DeviceItemTemplate}" />
      </toolkit:Expander>

      <!-- Thermostat Dropdown -->
      <toolkit:Expander>
        <toolkit:Expander.Header>
          <Label Text="Thermostat"
                 FontSize="18"
                 TextColor="Black"
                 HorizontalOptions="FillAndExpand" />
        </toolkit:Expander.Header>
        <CollectionView
          x:Name="ThermostatList"
          ItemsLayout="VerticalList"
          ItemTemplate="{StaticResource DeviceItemTemplate}" />
      </toolkit:Expander>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
