<?xml version="1.0" encoding="utf-8" ?>
<!--
    DevicePage.xaml: Page for viewing and managing all devices in the smart home application.
    Includes controls for adding, toggling, and removing devices, as well as thermostat settings.
-->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SmartHomeApp.ViewModels"
    xmlns:models="clr-namespace:SmartHomeApp.Models"
    xmlns:converters="clr-namespace:SmartHomeApp.Converters;assembly=SmartHomeApp"
    x:Class="SmartHomeApp.Views.DevicePage"
    Title="Devices"
    BackgroundColor="White">

  <!-- Resource definitions for converters and shared styles -->
  <ContentPage.Resources>
    <ResourceDictionary>
      <!-- Converter to show thermostat controls only for type == Thermostat -->
      <converters:ThermostatVisibilityConverter x:Key="ThermostatVisibilityConverter" />

      <!-- Default button style: blue background with white text -->
      <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="Blue" />
        <Setter Property="TextColor" Value="White" />
      </Style>
    </ResourceDictionary>
  </ContentPage.Resources>

  <!-- Bind this page to MainViewModel for data context -->
  <ContentPage.BindingContext>
    <vm:MainViewModel />
  </ContentPage.BindingContext>

  <!-- Scrollable container to accommodate varying content height -->
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="20">

      <!-- Page header label -->
      <Label Text="Devices" FontSize="24" TextColor="Black" />

      <!-- Section: Add New Device -->
      <Entry x:Name="DeviceNameEntry"
             Placeholder="Enter device name" />

      <Picker x:Name="DeviceTypePicker"
              Title="Select device type">
        <Picker.ItemsSource>
          <x:Array Type="{x:Type x:String}">
            <!-- Supported device types -->
            <x:String>Light</x:String>
            <x:String>Thermostat</x:String>
            <x:String>Door Lock</x:String>
          </x:Array>
        </Picker.ItemsSource>
      </Picker>

      <!-- Button to add a device using values from Entry and Picker -->
      <Button Text="Add Device"
              Clicked="OnAddDeviceClicked" />

      <!-- Devices list displayed using CollectionView -->
      <CollectionView ItemsSource="{Binding Devices}">
        <CollectionView.ItemTemplate>
          <!-- DataTemplate strongly typed to Device model -->
          <DataTemplate x:DataType="models:Device">
            <VerticalStackLayout Spacing="10">

              <!-- Device info row: name, on/off switch, remove button -->
              <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                <!-- Device name label -->
                <Label Grid.Column="0"
                       Text="{Binding Name}"
                       VerticalOptions="Center"
                       TextColor="Black" />

                <!-- Power toggle: hidden for thermostat types via DataTrigger -->
                <Switch Grid.Column="1"
                        IsToggled="{Binding IsOn}"
                        OnColor="Blue"
                        ThumbColor="White"
                        VerticalOptions="Center">
                  <Switch.Triggers>
                    <DataTrigger TargetType="Switch"
                                 Binding="{Binding Type}"
                                 Value="Thermostat">
                      <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                  </Switch.Triggers>
                </Switch>

                <!-- Remove button with red background -->
                <Button Grid.Column="2"
                        Text="Remove"
                        Clicked="OnRemoveDeviceClicked"
                        CommandParameter="{Binding Id}"
                        BackgroundColor="Red"
                        TextColor="White" />
              </Grid>

              <!-- Thermostat-specific controls: visible only for Type == Thermostat -->
              <VerticalStackLayout
                IsVisible="{Binding Type, Converter={StaticResource ThermostatVisibilityConverter}}"
                Spacing="5">

                <!-- Display current temperature -->
                <Label Text="{Binding Temperature, StringFormat='Temp: {0}°F'}"
                       TextColor="Black" />

                <!-- Controls to set a new temperature -->
                <HorizontalStackLayout Spacing="10">
                  <Entry WidthRequest="60"
                         Keyboard="Numeric"
                         Placeholder="50–90" />
                  <Button Text="Set"
                          Clicked="OnSetTempClicked" />
                </HorizontalStackLayout>
              </VerticalStackLayout>

            </VerticalStackLayout>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
