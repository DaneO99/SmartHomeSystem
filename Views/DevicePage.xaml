<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:SmartHomeApp.ViewModels"
    xmlns:models="clr-namespace:SmartHomeApp.Models"
    x:Class="SmartHomeApp.Views.DevicePage"
    Title="Devices"
    BackgroundColor="White"
    x:DataType="vm:MainViewModel">

  <ContentPage.Resources>
    <!-- Implicit Button style -->
    <Style TargetType="Button">
      <Setter Property="BackgroundColor" Value="Blue"/>
      <Setter Property="TextColor" Value="White"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
  </ContentPage.Resources>

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="20">

      <!-- Logo -->
      <Image
        Source="devicelogo.png"
        HeightRequest="60"
        WidthRequest="60"
        HorizontalOptions="Center" />

      <!-- Add Device -->
      <Label Text="Add Device" FontAttributes="Bold" FontSize="18"/>
      <HorizontalStackLayout Spacing="10">
        <Entry x:Name="DeviceNameEntry"
               Placeholder="Name"
               HorizontalOptions="FillAndExpand"/>
        <Picker x:Name="DeviceTypePicker" Title="Type">
          <Picker.ItemsSource>
            <x:Array Type="{x:Type x:String}">
              <x:String>Light</x:String>
              <x:String>Thermostat</x:String>
              <x:String>Door Lock</x:String>
            </x:Array>
          </Picker.ItemsSource>
        </Picker>
        <Button Text="+" Clicked="OnAddDeviceClicked" WidthRequest="40" HeightRequest="40"/>
      </HorizontalStackLayout>

      <!-- Lights Section -->
      <toolkit:Expander>
        <toolkit:Expander.Header>
          <Grid ColumnDefinitions="*,Auto">
            <Label Text="Lights" FontAttributes="Bold" FontSize="16"/>
            <Label Text="⌄" FontSize="16" HorizontalOptions="End"/>
          </Grid>
        </toolkit:Expander.Header>
        <toolkit:Expander.Content>
          <CollectionView ItemsSource="{Binding Lights}">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="models:Device">
                <Grid ColumnDefinitions="*,Auto,Auto" Padding="5">
                  <Label Text="{Binding Name}" VerticalOptions="Center"/>
                  <Switch Grid.Column="1"
                          IsToggled="{Binding IsOn}"
                          OnColor="White"
                          ThumbColor="Blue"
                          VerticalOptions="Center"/>
                  <Button Grid.Column="2"
                          Text="✕"
                          FontAttributes="Bold"
                          FontSize="18"
                          TextColor="Black"
                          BackgroundColor="Red"
                          Padding="0"
                          WidthRequest="30"
                          HeightRequest="30"
                          HorizontalOptions="End"
                          VerticalOptions="Center"
                          Clicked="OnRemoveDeviceClicked"
                          CommandParameter="{Binding Id}"/>
                </Grid>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </toolkit:Expander.Content>
      </toolkit:Expander>

      <!-- Door Locks Section -->
      <toolkit:Expander>
        <toolkit:Expander.Header>
          <Grid ColumnDefinitions="*,Auto">
            <Label Text="Door Locks" FontAttributes="Bold" FontSize="16"/>
            <Label Text="⌄" FontSize="16" HorizontalOptions="End"/>
          </Grid>
        </toolkit:Expander.Header>
        <toolkit:Expander.Content>
          <CollectionView ItemsSource="{Binding DoorLocks}">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="models:Device">
                <Grid ColumnDefinitions="*,Auto,Auto" Padding="5">
                  <Label Text="{Binding Name}" VerticalOptions="Center"/>
                  <Switch Grid.Column="1"
                          IsToggled="{Binding IsOn}"
                          OnColor="White"
                          ThumbColor="Blue"
                          VerticalOptions="Center"/>
                  <Button Grid.Column="2"
                          Text="✕"
                          FontAttributes="Bold"
                          FontSize="18"
                          TextColor="Black"
                          BackgroundColor="Red"
                          Padding="0"
                          WidthRequest="30"
                          HeightRequest="30"
                          HorizontalOptions="End"
                          VerticalOptions="Center"
                          Clicked="OnRemoveDeviceClicked"
                          CommandParameter="{Binding Id}"/>
                </Grid>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </toolkit:Expander.Content>
      </toolkit:Expander>

      <!-- Thermostat Section -->
      <toolkit:Expander>
        <toolkit:Expander.Header>
          <Grid ColumnDefinitions="*,Auto">
            <Label Text="Thermostat" FontAttributes="Bold" FontSize="16"/>
            <Label Text="⌄" FontSize="16" HorizontalOptions="End"/>
          </Grid>
        </toolkit:Expander.Header>
        <toolkit:Expander.Content>
          <CollectionView ItemsSource="{Binding Thermostats}">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="models:Device">
                <VerticalStackLayout Padding="5" Spacing="5">
                  <Label Text="{Binding Name}" FontAttributes="Bold"/>
                  <HorizontalStackLayout Spacing="10">
                    <!-- Animated label -->
                    <Label x:Name="TempLabel"
                           Text="{Binding Temperature, StringFormat='Temp: {0}°F'}"
                           VerticalOptions="Center"/>
                    <!-- Plain entry for user input -->
                    <Entry x:Name="TempEntry"
                           WidthRequest="60"
                           Keyboard="Numeric"
                           Placeholder="60–90"/>
                    <Button Text="Set" Clicked="OnSetTempClicked"/>
                    <Button Text="✕"
                            FontAttributes="Bold"
                            FontSize="18"
                            TextColor="Black"
                            BackgroundColor="Red"
                            Padding="0"
                            WidthRequest="30"
                            HeightRequest="30"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Clicked="OnRemoveDeviceClicked"
                            CommandParameter="{Binding Id}"/>
                  </HorizontalStackLayout>
                </VerticalStackLayout>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </toolkit:Expander.Content>
      </toolkit:Expander>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
