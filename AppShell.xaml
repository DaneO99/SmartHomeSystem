<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="SmartHomeApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SmartHomeApp.Views;assembly=SmartHomeApp"
    Title="SmartHomeApp"
    FlyoutBehavior="Flyout">

  <!-- Dashboard -->
  <FlyoutItem
      Title="Dashboard"
      Route="dashboard"
      Icon="logo.png">
    <ShellContent
        Route="dashboard"
        ContentTemplate="{DataTemplate views:MainPage}" />
  </FlyoutItem>

  <!-- Devices -->
  <FlyoutItem
      Title="Devices"
      Route="devices"
      Icon="devicelogo.png">
    <ShellContent
        Route="devices"
        ContentTemplate="{DataTemplate views:DevicePage}" />
  </FlyoutItem>

  <!-- Rooms -->
  <FlyoutItem
      Title="Rooms"
      Route="rooms"
      Icon="roomlogo.png">
    <ShellContent
        Route="rooms"
        ContentTemplate="{DataTemplate views:RoomPage}" />
  </FlyoutItem>

  <!-- Schedules -->
  <FlyoutItem
      Title="Schedules"
      Route="schedules"
      Icon="schedulelogo.png">
    <ShellContent
        Route="schedules"
        ContentTemplate="{DataTemplate views:SchedulePage}" />
  </FlyoutItem>

  <!-- Logout -->
  <MenuItem
      Text="Logout"
      IconImageSource="locklogo.png"
      Clicked="OnLogoutClicked" />

</Shell>
